{
  "info": {
    "name": "Authentication Service API",
    "description": "Full API collection for the CamboFreelance authentication & CMS service.",
    "_postman_id": "cambofreelance-auth-service-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",     "value": "http://localhost:8080",  "type": "string" },
    { "key": "access_token", "value": "",                        "type": "string" },
    { "key": "refresh_token","value": "",                        "type": "string" },
    { "key": "user_id",      "value": "",                        "type": "string" },
    { "key": "device_id",    "value": "web-browser-001",         "type": "string" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.access_token) {",
                  "  pm.collectionVariables.set('access_token',  json.data.access_token);",
                  "  pm.collectionVariables.set('refresh_token', json.data.refresh_token);",
                  "  pm.collectionVariables.set('user_id',       json.data.user_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/oauth/token", "host": ["{{base_url}}"], "path": ["oauth","token"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"password\",\n  \"username\": \"admin@cambofreelance.com\",\n  \"password\": \"Admin@1234\",\n  \"client_id\": \"cambofreelance-cms\",\n  \"client_secret\": \"secret\",\n  \"scope\": \"openid\",\n  \"application_type\": \"WEB\",\n  \"device_id\": \"{{device_id}}\"\n}"
            }
          }
        },
        {
          "name": "Login (refresh_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.access_token) {",
                  "  pm.collectionVariables.set('access_token',  json.data.access_token);",
                  "  pm.collectionVariables.set('refresh_token', json.data.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/oauth/token", "host": ["{{base_url}}"], "path": ["oauth","token"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"refresh_token\",\n  \"refresh_token\": \"{{refresh_token}}\",\n  \"client_id\": \"cambofreelance-cms\",\n  \"client_secret\": \"secret\",\n  \"device_id\": \"{{device_id}}\"\n}"
            }
          }
        },
        {
          "name": "Login (Google OAuth)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/oauth/token", "host": ["{{base_url}}"], "path": ["oauth","token"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"social\",\n  \"provider\": \"google\",\n  \"code\": \"<google-auth-code>\",\n  \"redirect_uri\": \"http://localhost:3000/oauth/callback\",\n  \"client_id\": \"cambofreelance-cms\",\n  \"client_secret\": \"secret\",\n  \"device_id\": \"{{device_id}}\"\n}"
            }
          }
        },
        {
          "name": "Login (GitHub OAuth)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/oauth/token", "host": ["{{base_url}}"], "path": ["oauth","token"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"social\",\n  \"provider\": \"github\",\n  \"code\": \"<github-auth-code>\",\n  \"redirect_uri\": \"http://localhost:3000/oauth/callback\",\n  \"client_id\": \"cambofreelance-cms\",\n  \"client_secret\": \"secret\",\n  \"device_id\": \"{{device_id}}\"\n}"
            }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/oauth/register", "host": ["{{base_url}}"], "path": ["oauth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"phoneNumber\": \"+85512345678\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password@123\",\n  \"confirmPassword\": \"Password@123\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/oauth/forgot-password", "host": ["{{base_url}}"], "path": ["oauth","forgot-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/oauth/reset-password", "host": ["{{base_url}}"], "path": ["oauth","reset-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewPassword@123\",\n  \"confirmPassword\": \"NewPassword@123\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "User-Id",       "value": "{{user_id}}" },
              { "key": "Device-Id",     "value": "{{device_id}}" }
            ],
            "url": { "raw": "{{base_url}}/oauth/logout", "host": ["{{base_url}}"], "path": ["oauth","logout"] }
          }
        }
      ]
    },

    {
      "name": "Public Articles",
      "item": [
        {
          "name": "List Published Articles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/articles?type=BLOGS&search=&page=0&size=20",
              "host": ["{{base_url}}"],
              "path": ["articles"],
              "query": [
                { "key": "type",   "value": "BLOGS",   "description": "NEWS | PROMOTIONS | BLOGS | ANNOUNCEMENTS | SERVICE | TEAM | COURSE | PRODUCTS | TUTORIAL" },
                { "key": "search", "value": "",         "disabled": true },
                { "key": "page",   "value": "0" },
                { "key": "size",   "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Article by ID (public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/articles/:id", "host": ["{{base_url}}"], "path": ["articles",":id"], "variable": [{ "key": "id", "value": "article-uuid-here" }] }
          }
        },
        {
          "name": "Get Article by Slug",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/articles/slug/:slug", "host": ["{{base_url}}"], "path": ["articles","slug",":slug"], "variable": [{ "key": "slug", "value": "my-first-blog-post" }] }
          }
        }
      ]
    },

